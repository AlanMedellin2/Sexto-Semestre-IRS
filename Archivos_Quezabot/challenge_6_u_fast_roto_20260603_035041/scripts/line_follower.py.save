#!/usr/bin/env python3
import rclpy
from rclpy.node import Node

from std_msgs.msg import Int32
from geometry_msgs.msg import Twist


class LineFollowerPID(Node):

    def __init__(self):
        super().__init__('line_follower_pid')

        # ====================================
        # Subscriber
        # ====================================
        self.subscription = self.create_subscription(
            Int32,
            '/line_error',
            self.error_callback,
            10
        )

        # ====================================
        # Publisher
        # ====================================
        self.cmd_pub = self.create_publisher(
            Twist,
            '/cmd_vel',
            10
        )

        # ====================================
        # PID
        # ====================================
        self.kp = 0.015
        self.ki = 0.0
        self.kd = 0.003

        self.error = 0.0
        self.prev_error = 0.0
        self.integral = 0.0

        self.dt = 0.05

        # ====================================
        # Robot
        # ====================================
        self.base_speed = 0.10

        self.deadband = 30

        self.max_linear = 0.10
        self.max_angular = 

        # ====================================
        # Rampa de velocidad
        # ====================================

        # velocidades actuales
        self.current_linear = 0.0
        self.current_angular = 0.0

        # cuánto puede cambiar por ciclo
        self.linear_accel = 0.01
        self.angular_accel = 0.08

        # ====================================
        # Timer
        # ====================================
        self.timer = self.create_timer(
            self.dt,
            self.control_loop
        )

        self.get_logger().info(
            "Line follower PID iniciado"
        )

    # ====================================
    # Callback error
    # ====================================
    def error_callback(self, msg):

        self.error = float(msg.data)

    # ====================================
    # Saturación
    # ====================================
    def saturate(self, value, limit):

        return max(
            -limit,
            min(limit, value)
        )

    # ====================================
    # Función rampa
    # ====================================
    def ramp(self, target, current, step):

        if target > current:
            current += step

            if current > target:
                current = target

        elif target < current:
            current -= step

            if current < target:
                current = target

        return current

    # ====================================
    # Loop principal
    # ====================================
    def control_loop(self):

        # ====================================
        # PID
        # ====================================
        proportional = self.error

        self.integral += self.error * self.dt

        derivative = (
            self.error - self.prev_error
        ) / self.dt

        angular_pid = (
            self.kp * proportional +
            self.ki * self.integral +
            self.kd * derivative
        )

        self.prev_error = self.error

        # ====================================
        # Saturar PID
        # ====================================
        angular_pid = self.saturate(
            angular_pid,
            self.max_angular
        )

        # ====================================
        # Velocidades objetivo
        # ====================================

        target_linear = 0.0
        target_angular = 0.0

        # Si está centrado:
        # avanzar recto
        if abs(self.error) < self.deadband:

            target_linear = self.base_speed
            target_angular = 0.0

        else:

            # avanzar lento mientras gira
            target_linear = self.base_speed * 0.5

            # corregir dirección
            target_angular = -angular_pid

        # ====================================
        # Aplicar rampas
        # ====================================
        self.current_linear = self.ramp(
            target_linear,
            self.current_linear,
            self.linear_accel
        )

        self.current_angular = self.ramp(
            target_angular,
            self.current_angular,
            self.angular_accel
        )

        # ====================================
        # Saturar velocidades finales
        # ====================================
        self.current_linear = self.saturate(
            self.current_linear,
            self.max_linear
        )

        self.current_angular = self.saturate(
            self.current_angular,
            self.max_angular
        )

        # ====================================
        # Publicar cmd_vel
        # ====================================
        cmd = Twist()

        cmd.linear.x = self.current_linear
        cmd.angular.z = self.current_angular

        self.cmd_pub.publish(cmd)

        # ====================================
        # Debug
        # ====================================
        self.get_logger().info(
            f'Error: {self.error:.1f} | '
            f'Lin: {self.current_linear:.2f} | '
            f'Ang: {self.current_angular:.2f}'
        )


def main(args=None):

    rclpy.init(args=args)

    node = LineFollowerPID()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
