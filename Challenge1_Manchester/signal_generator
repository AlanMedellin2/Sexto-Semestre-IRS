
import rclpy 
import math                               
from rclpy.node import Node               #clases nodo
from std_msgs.msg import Float32           #Mensajes estandarizados


class MinimalPublisher(Node):             #definimos la clase
   def __init__(self):
    super().__init__('signal_generator')   #'nombre de nodo'

    self.publisher_signal = self.create_publisher(Float32, '/signal', 10) # (tipo dato, 'nombre de tópico', 10 datos se almacenan)
    self.publisher_timer = self.create_publisher(Float32, '/time', 10) #topic2
    self.timer = self.create_timer(0.1,self.timer_callback) #10 hz
    self.i=0

   def timer_callback(self):
    self.i+= 0.1 #aumenta
    signal = math.sin(self.i)   #cálculo seno
    msg = Float32()
    msg.data = float(signal)
    self.publisher_signal.publish(msg) #Se manda el mensaje al publish 

    msg_timer = Float32()
    msg_timer.data = float(self.i)
    self.publisher_timer.publish(msg_timer) #Mnda el mensaje  

    self.get_logger().info(f"t={self.i} signal={msg.data}") #lo que se va a mostrar en terminal


def main(args=None):
    rclpy.init(args=args)                   #se inicializa el nodo

    minimal_publisher = MinimalPublisher() #inicializamos la clase y generamos objeto

    try:
        rclpy.spin(minimal_publisher)       #donde ros llama a la clase, poner a correr el nodo
    except KeyboardInterrupt:               # con ctrl C, detenemos el nodo(shutdown)
        pass
    finally:
        if rclpy.ok():
            rclpy.shutdown()
        minimal_publisher.destroy_node()


if __name__ == '__main__':
    main()
